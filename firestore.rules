rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(roles) {
      return signedIn()
        && userProfile().data.enabled == true
        && userProfile().data.role in roles;
    }

    function canView() {
      return hasRole(['super_admin', 'admin', 'standard', 'manager', 'viewer']);
    }

    function canManageProduction() {
      return hasRole(['super_admin', 'admin', 'standard', 'manager']);
    }

    function canManageAdministration() {
      return hasRole(['super_admin', 'admin']);
    }

    function isSuperAdmin() {
      return hasRole(['super_admin'])
        || (signedIn()
          && request.auth.uid == 'TOXwE0xXDlgoL4YqBbrTOGjxCyk1'
          && userProfile().data.enabled == true);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update, delete: if isSuperAdmin();
    }

    match /configuration/{documentId} {
      allow read: if canView();
      allow write: if canManageAdministration();
    }

    match /jobs/{jobId} {
      allow read: if canView();
      allow create: if !exists(/databases/$(database)/documents/archivedJobs/$(jobId))
        && !exists(/databases/$(database)/documents/archiveHistoryLocks/$(request.resource.data.jobNumber))
        && canManageProduction();
      // Only remove the active record when this commit preserves its exact snapshot.
      allow delete: if canManageAdministration()
        && !exists(/databases/$(database)/documents/archivedJobs/$(jobId))
        && getAfter(/databases/$(database)/documents/archivedJobs/$(jobId)).data.job == resource.data
        && getAfter(/databases/$(database)/documents/archivedJobs/$(jobId)).data.historyStatus == 'capturing'
        && getAfter(/databases/$(database)/documents/archivedJobs/$(jobId)).data.archivedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/archivedJobs/$(jobId)).data.archivedAt == request.time;
      allow update: if canManageProduction()
        && (!hasRole(['standard']) || request.resource.data.dueDate == resource.data.dueDate);
    }

    // Immutable full snapshots. Deploy these rules before enabling the Archive UI.
    match /archivedJobs/{jobId} {
      allow read: if canManageAdministration();
      allow create: if canManageAdministration()
        && request.resource.data.keys().hasOnly(['job', 'departments', 'statuses', 'archivedAt', 'archivedBy', 'historyStatus', 'historyCodes'])
        && request.resource.data.job == get(/databases/$(database)/documents/jobs/$(jobId)).data
        && (request.resource.data.job.get('billingState', '') == 'approved'
          || (!('billingState' in request.resource.data.job) && 'billingApprovedAt' in request.resource.data.job))
        && request.resource.data.departments == get(/databases/$(database)/documents/configuration/plantflow).data.departments
        && request.resource.data.statuses == get(/databases/$(database)/documents/configuration/plantflow).data.statuses
        && request.resource.data.historyStatus == "capturing"
        && request.resource.data.historyCodes is list
        && request.resource.data.archivedBy == request.auth.uid
        && request.resource.data.archivedAt == request.time
        && !existsAfter(/databases/$(database)/documents/jobs/$(jobId))
        && !existsAfter(/databases/$(database)/documents/publicJobs/$(jobId));
      allow update: if canManageAdministration()
        && resource.data.historyStatus == 'capturing'
        && request.resource.data.historyStatus == 'complete'
        && request.resource.data.historyCapturedAt == request.time
        && request.resource.data.historyEventCount is int
        && request.resource.data.historyEventCount >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['historyStatus', 'historyCapturedAt', 'historyEventCount']);
      allow delete: if false;
      match /events/{eventId} {
        allow read: if canManageAdministration();
        allow create, update: if canManageAdministration()
          && get(/databases/$(database)/documents/archivedJobs/$(jobId)).data.historyStatus == 'capturing'
          && request.resource.data == get(/databases/$(database)/documents/scanEvents/$(eventId)).data
          && (request.resource.data.get('jobId', '') == jobId
            || (!('jobId' in request.resource.data)
              && request.resource.data.jobNumber in get(/databases/$(database)/documents/archivedJobs/$(jobId)).data.historyCodes));
        allow delete: if false;
      }
    }

    match /archiveHistoryLocks/{code} {
      allow read: if canManageAdministration();
      allow create: if canManageAdministration()
        && request.resource.data.keys().hasOnly(['archiveId'])
        && getAfter(/databases/$(database)/documents/archivedJobs/$(request.resource.data.archiveId)).data.historyStatus == 'capturing'
        && code in getAfter(/databases/$(database)/documents/archivedJobs/$(request.resource.data.archiveId)).data.historyCodes;
      allow delete: if canManageAdministration()
        && getAfter(/databases/$(database)/documents/archivedJobs/$(resource.data.archiveId)).data.historyStatus == 'complete';
      allow update: if false;
    }

    function historyWritable(data) {
      return !exists(/databases/$(database)/documents/archiveHistoryLocks/$(data.jobNumber))
        && (!('jobId' in data) || !exists(/databases/$(database)/documents/archivedJobs/$(data.jobId)));
    }

    match /scanEvents/{eventId} {
      allow read: if canView();
      allow create: if canManageProduction() && historyWritable(request.resource.data);
      allow update: if canManageProduction() && historyWritable(resource.data) && historyWritable(request.resource.data);
      allow delete: if hasRole(['super_admin', 'admin']) && historyWritable(resource.data);
    }

    match /publicConfiguration/{documentId} {
      allow read: if true;
      allow write: if canManageAdministration();
    }

    match /publicJobs/{jobId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/archivedJobs/$(jobId))
        && !exists(/databases/$(database)/documents/archiveHistoryLocks/$(request.resource.data.jobNumber))
        && canManageProduction();
      allow delete: if canManageProduction();
      allow update: if canManageProduction();
    }
  }
}
