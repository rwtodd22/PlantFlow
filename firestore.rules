rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(roles) {
      return signedIn()
        && userProfile().data.enabled == true
        && userProfile().data.get('removed', false) == false
        && userProfile().data.role in roles;
    }

    function canView() {
      return hasRole(['super_admin', 'admin', 'standard']);
    }

    function canManageProduction() {
      return hasRole(['super_admin', 'admin', 'standard']);
    }

    function isJobCreator() {
      return hasRole(['job_creator']);
    }

    function canCreateJob(data) {
      return (canManageProduction() && (!hasRole(['standard'])
        || !data.keys().hasAny(['billingState', 'billingNote', 'billingApprovedAt', 'billingClearedAt']))) || (isJobCreator()
        && data.createdBy == request.auth.uid
        && data.id is string && data.jobNumber is string
        && data.jobNumber.size() > 0
        && !('billingState' in data) && !('billingApprovedAt' in data)
        && !('completedAt' in data));
    }

    function canManageAdministration() {
      return hasRole(['super_admin', 'admin']);
    }

    function isSuperAdmin() {
      return hasRole(['super_admin'])
        || (signedIn()
          && request.auth.uid == 'TOXwE0xXDlgoL4YqBbrTOGjxCyk1'
          && userProfile().data.enabled == true
          && userProfile().data.get('removed', false) == false);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update, delete: if isSuperAdmin();
      allow update: if signedIn() && request.auth.uid == userId
        && resource.data.enabled == true && resource.data.get('removed', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSignInAt'])
        && request.resource.data.lastSignInAt == request.time;
    }

    match /configuration/{documentId} {
      allow read: if canView() || (isJobCreator() && documentId in ['plantflow', 'jobPeople']);
      allow write: if canManageAdministration();
    }

    function notDeleted(jobId) {
      return !exists(/databases/$(database)/documents/jobDeletions/$(jobId));
    }

    function deletionCompleting(jobId) {
      return get(/databases/$(database)/documents/jobDeletions/$(jobId)).data.state == 'pending'
        && getAfter(/databases/$(database)/documents/jobDeletions/$(jobId)).data.state == 'complete'
        && getAfter(/databases/$(database)/documents/jobDeletions/$(jobId)).data.completedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/jobDeletions/$(jobId)).data.completedAt == request.time;
    }

    // Separate explicit administrator workflow, never an archive escape hatch.
    // Pending snapshots freeze edits during cleanup; only a minimal audit receipt remains.
    match /jobDeletions/{jobId} {
      allow read: if canManageAdministration();
      allow create: if canManageAdministration()
        && request.resource.data.keys().hasOnly(['job', 'jobNumber', 'codes', 'state', 'requestedBy', 'requestedAt', 'confirmation', 'bulkReset'])
        && (!request.resource.data.get('bulkReset', false) || hasRole(['super_admin']))
        && !exists(/databases/$(database)/documents/archivedJobs/$(jobId))
        && request.resource.data.job == get(/databases/$(database)/documents/jobs/$(jobId)).data
        && request.resource.data.jobNumber == request.resource.data.job.jobNumber
        && request.resource.data.job.get('billingState', '') != 'approved'
        && ('billingState' in request.resource.data.job || !('billingApprovedAt' in request.resource.data.job))
        && request.resource.data.codes is list
        && request.resource.data.jobNumber in request.resource.data.codes
        && request.resource.data.state == 'pending'
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedAt == request.time
        && request.resource.data.confirmation == 'DELETE ' + request.resource.data.jobNumber
        && existsAfter(/databases/$(database)/documents/jobs/$(jobId));
      allow update: if canManageAdministration()
        && resource.data.state == 'pending'
        && request.resource.data.state == 'complete'
        && !('job' in request.resource.data)
        && request.resource.data.completedAt == request.time
        && request.resource.data.completedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['job', 'state', 'completedAt', 'completedBy'])
        && !exists(/databases/$(database)/documents/archivedJobs/$(jobId))
        && !existsAfter(/databases/$(database)/documents/jobs/$(jobId))
        && !existsAfter(/databases/$(database)/documents/publicJobs/$(jobId));
      allow delete: if false;
    }

    match /deletionHistoryLocks/{code} {
      allow read: if canManageAdministration();
      allow create: if canManageAdministration()
        && request.resource.data.keys().hasOnly(['jobId'])
        && !exists(/databases/$(database)/documents/archiveHistoryLocks/$(code))
        && getAfter(/databases/$(database)/documents/jobDeletions/$(request.resource.data.jobId)).data.state == 'pending'
        && code in getAfter(/databases/$(database)/documents/jobDeletions/$(request.resource.data.jobId)).data.codes;
      allow update: if false;
      allow delete: if canManageAdministration() && deletionCompleting(resource.data.jobId);
    }

    match /jobs/{jobId} {
      allow read: if canView() || isJobCreator();
      allow create: if !exists(/databases/$(database)/documents/archivedJobs/$(jobId))
        && notDeleted(jobId)
        && !exists(/databases/$(database)/documents/deletionHistoryLocks/$(request.resource.data.jobNumber))
        && !exists(/databases/$(database)/documents/archiveHistoryLocks/$(request.resource.data.jobNumber))
        && canCreateJob(request.resource.data);
      // Only remove the active record when this commit preserves its exact snapshot.
      allow delete: if canManageAdministration()
        && !exists(/databases/$(database)/documents/archivedJobs/$(jobId))
        && getAfter(/databases/$(database)/documents/archivedJobs/$(jobId)).data.job == resource.data
        && getAfter(/databases/$(database)/documents/archivedJobs/$(jobId)).data.historyStatus == 'capturing'
        && getAfter(/databases/$(database)/documents/archivedJobs/$(jobId)).data.archivedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/archivedJobs/$(jobId)).data.archivedAt == request.time;
      allow delete: if canManageAdministration()
        && !exists(/databases/$(database)/documents/archivedJobs/$(jobId))
        && get(/databases/$(database)/documents/jobDeletions/$(jobId)).data.job == resource.data
        && deletionCompleting(jobId);
      allow update: if canManageProduction()
        && notDeleted(jobId)
        && (!hasRole(['standard']) || (request.resource.data.dueDate == resource.data.dueDate
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['billingState', 'billingNote', 'billingApprovedAt', 'billingClearedAt'])));
    }

    // Immutable full snapshots. Deploy these rules before enabling the Archive UI.
    match /archivedJobs/{jobId} {
      allow read: if canManageAdministration();
      allow create: if canManageAdministration()
        && notDeleted(jobId)
        && request.resource.data.keys().hasOnly(['job', 'departments', 'statuses', 'archivedAt', 'archivedBy', 'historyStatus', 'historyCodes'])
        && request.resource.data.job == get(/databases/$(database)/documents/jobs/$(jobId)).data
        && (request.resource.data.job.get('billingState', '') == 'approved'
          || (!('billingState' in request.resource.data.job) && 'billingApprovedAt' in request.resource.data.job))
        && request.resource.data.departments == get(/databases/$(database)/documents/configuration/plantflow).data.departments
        && request.resource.data.statuses == get(/databases/$(database)/documents/configuration/plantflow).data.statuses
        && request.resource.data.historyStatus == "capturing"
        && request.resource.data.historyCodes is list
        && request.resource.data.archivedBy == request.auth.uid
        && request.resource.data.archivedAt == request.time
        && !existsAfter(/databases/$(database)/documents/jobs/$(jobId))
        && !existsAfter(/databases/$(database)/documents/publicJobs/$(jobId));
      allow update: if canManageAdministration()
        && resource.data.historyStatus == 'capturing'
        && request.resource.data.historyStatus == 'complete'
        && request.resource.data.historyCapturedAt == request.time
        && request.resource.data.historyEventCount is int
        && request.resource.data.historyEventCount >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['historyStatus', 'historyCapturedAt', 'historyEventCount']);
      allow delete: if false;
      match /events/{eventId} {
        allow read: if canManageAdministration();
        allow create, update: if canManageAdministration()
          && get(/databases/$(database)/documents/archivedJobs/$(jobId)).data.historyStatus == 'capturing'
          && request.resource.data == get(/databases/$(database)/documents/scanEvents/$(eventId)).data
          && (request.resource.data.get('jobId', '') == jobId
            || (!('jobId' in request.resource.data)
              && request.resource.data.jobNumber in get(/databases/$(database)/documents/archivedJobs/$(jobId)).data.historyCodes));
        allow delete: if false;
      }
    }

    match /archiveHistoryLocks/{code} {
      allow read: if canManageAdministration();
      allow create: if canManageAdministration()
        && request.resource.data.keys().hasOnly(['archiveId'])
        && getAfter(/databases/$(database)/documents/archivedJobs/$(request.resource.data.archiveId)).data.historyStatus == 'capturing'
        && code in getAfter(/databases/$(database)/documents/archivedJobs/$(request.resource.data.archiveId)).data.historyCodes;
      allow delete: if canManageAdministration()
        && getAfter(/databases/$(database)/documents/archivedJobs/$(resource.data.archiveId)).data.historyStatus == 'complete';
      allow update: if false;
    }

    function historyWritable(data) {
      return !exists(/databases/$(database)/documents/archiveHistoryLocks/$(data.jobNumber))
        && (!('jobId' in data) || !exists(/databases/$(database)/documents/archivedJobs/$(data.jobId)));
    }

    match /scanEvents/{eventId} {
      allow read: if canView();
      allow create: if canManageProduction() && historyWritable(request.resource.data) && deletionHistoryWritable(request.resource.data);
      allow update: if canManageProduction() && historyWritable(resource.data) && historyWritable(request.resource.data)
        && deletionHistoryWritable(resource.data) && deletionHistoryWritable(request.resource.data);
      allow delete: if hasRole(['super_admin', 'admin']) && historyWritable(resource.data);
    }

    function deletionHistoryWritable(data) {
      return !exists(/databases/$(database)/documents/deletionHistoryLocks/$(data.jobNumber))
        && (!('jobId' in data) || notDeleted(data.jobId));
    }

    match /publicConfiguration/{documentId} {
      allow read: if true;
      allow write: if canManageAdministration();
    }

    match /publicJobs/{jobId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/archivedJobs/$(jobId))
        && notDeleted(jobId)
        && !exists(/databases/$(database)/documents/deletionHistoryLocks/$(request.resource.data.jobNumber))
        && !exists(/databases/$(database)/documents/archiveHistoryLocks/$(request.resource.data.jobNumber))
        && (canManageProduction() || (isJobCreator()
          && !exists(/databases/$(database)/documents/jobs/$(jobId))
          && getAfter(/databases/$(database)/documents/jobs/$(jobId)).data.createdBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/jobs/$(jobId)).data.jobNumber == request.resource.data.jobNumber))
        && (!hasRole(['standard']) || request.resource.data.dueDate == getAfter(/databases/$(database)/documents/jobs/$(jobId)).data.dueDate);
      allow delete: if canManageProduction() && (notDeleted(jobId) || (canManageAdministration() && deletionCompleting(jobId)));
      allow update: if canManageProduction() && notDeleted(jobId)
        && (!hasRole(['standard']) || request.resource.data.dueDate == getAfter(/databases/$(database)/documents/jobs/$(jobId)).data.dueDate);
    }
  }
}
